{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "euicapital",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    // MUST stay "none". With "404-page", Cloudflare's asset layer treats
    // out/404.html as a match for any unmatched HTML navigation and serves it
    // WITHOUT invoking the Worker — which killed the `/` -> `/ro/` redirect for
    // real browsers while curl (Accept: */*) still fell through and worked.
    // "none" lets every unmatched request reach the Worker, which serves its
    // own localised 404 with a 404 status.
    "not_found_handling": "none"
  },
  // Both hostnames are attached to this Worker, so both resolve after deploy.
  // The Worker folds www onto the apex; see README "Custom domain".
  // Requires euicapital.ro to be an active zone in this Cloudflare account.
  "routes": [
    { "pattern": "euicapital.ro", "custom_domain": true },
    { "pattern": "www.euicapital.ro", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "vars": {
    "CANONICAL_HOST": "euicapital.ro",
    // Where enquiries are delivered.
    "CONTACT_TO": "icapitalgrup@gmail.com",
    // Sender. Requires euicapital.ro to be verified in Resend; swap for
    // "onboarding@resend.dev" to test before the domain is verified.
    "CONTACT_FROM": "EUI Capital <contact@euicapital.ro>"
  }
  // Optional lead storage — create with:  npx wrangler kv namespace create LEADS
  // "kv_namespaces": [{ "binding": "LEADS", "id": "<paste-id-here>" }]
}
